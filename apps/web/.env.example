# VITE_* values are public (embedded in the browser bundle). Never put secrets here.
# ws:// is for localhost only; production must use wss://.
VITE_SIGNALING_URL=ws://localhost:8787/ws
# Comma-separated STUN URLs (stun:/stuns: only). Empty = no STUN (same-network/local only).
# Cloudflare's STUN service is free (developers.cloudflare.com/realtime/turn/faq/); it sees your IP.
VITE_STUN_URLS=stun:stun.cloudflare.com:3478
